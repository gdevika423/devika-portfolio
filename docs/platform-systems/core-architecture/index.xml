      &lt;tr&gt;
          &lt;td&gt;Plan&lt;/td&gt;
          &lt;td&gt;Identify impacted content&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;Draft&lt;/td&gt;
          &lt;td&gt;Create documentation&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;Review&lt;/td&gt;
          &lt;td&gt;Validate accuracy&lt;/td&gt;
      &lt;/tr&gt;
